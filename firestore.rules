rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all for any unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidItemData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 250 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100 &&
             data.quantity is number && data.quantity >= 0 &&
             data.unitCost is number && data.unitCost >= 0 &&
             data.retailPrice is number && data.retailPrice >= 0 &&
             (!('wholesalePrice' in data) || (data.wholesalePrice is number && data.wholesalePrice >= 0)) &&
             (!('hasPromo' in data) || data.hasPromo is bool) &&
             (!('promoPrice' in data) || (data.promoPrice is number && data.promoPrice >= 0)) &&
             (!('promoStartDate' in data) || (data.promoStartDate is string && data.promoStartDate.size() <= 30)) &&
             (!('promoEndDate' in data) || (data.promoEndDate is string && data.promoEndDate.size() <= 30));
    }

    function isValidExpenseData(data) {
      return data.date is string && data.date.size() > 0 &&
             data.category is string && data.category.size() > 0 &&
             data.amount is number && data.amount >= 0 &&
             data.description is string;
    }

    function isValidDepositData(data) {
      return data.date is string && data.date.size() > 0 &&
             data.amount is number && data.amount >= 0 &&
             data.depositMethod is string &&
             data.bankName is string &&
             data.depositorName is string;
    }

    function isValidDispatchData(data) {
      return data.repName is string && data.repName.size() > 0 &&
             data.dispatchNumber is string && data.dispatchNumber.size() > 0 &&
             data.totalSumTaken is number && data.totalSumTaken >= 0 &&
             data.status is string;
    }

    function isValidCreditPaymentData(data) {
      return data.date is string && data.date.size() > 0 &&
             data.customerName is string && data.customerName.size() > 0 &&
             data.amount is number && data.amount > 0 &&
             data.paymentMethod in ['Cash', 'Bank Transfer', 'POS / Card'];
    }

    function isValidCrateReturnData(data) {
      return data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100 &&
             data.quantity is number && data.quantity >= 0 &&
             (!('cratesTakenOut' in data) || (data.cratesTakenOut is number && data.cratesTakenOut >= 0)) &&
             data.date is string && data.date.size() > 0;
    }

    function isValidReceiptData(data) {
      return data.receiptNumber is string && data.receiptNumber.size() > 0 && data.receiptNumber.size() <= 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() <= 100 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 50 &&
             data.operator is string && data.operator.size() <= 150 &&
             data.paymentMethod is string && data.paymentMethod.size() > 0 && data.paymentMethod.size() <= 50 &&
             data.items is list && data.items.size() <= 500 &&
             data.grandTotal is number && data.grandTotal >= 0 &&
             data.amountPaid is number && data.amountPaid >= 0;
    }

    function isValidPurchaseOrderData(data) {
      return data.poNumber is string && data.poNumber.size() > 0 && data.poNumber.size() <= 100 &&
             data.supplierId is string && data.supplierId.size() <= 128 &&
             data.supplierName is string && data.supplierName.size() > 0 && data.supplierName.size() <= 200 &&
             data.items is list && data.items.size() <= 500 &&
             data.status in ['draft', 'ordered', 'received', 'cancelled'] &&
             data.orderDate is string && data.orderDate.size() > 0 && data.orderDate.size() <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0;
    }

    function isValidSupplierData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.contactPerson is string && data.contactPerson.size() <= 150 &&
             data.email is string && data.email.size() <= 150 &&
             data.phone is string && data.phone.size() <= 80 &&
             data.leadTimeDays is number && data.leadTimeDays >= 0;
    }

    // Items Collection - Synced across all authorized desktop and remote devices
    match /items/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId) && isValidItemData(request.resource.data);
      allow update: if isValidId(itemId) && isValidItemData(request.resource.data);
      allow delete: if isValidId(itemId);
    }

    // Stock Movements Collection - Audit ledger log
    match /stock_movements/{movementId} {
      allow read: if true;
      allow create: if isValidId(movementId) &&
                       request.resource.data.itemId is string &&
                       request.resource.data.quantityDelta is number;
      allow update: if false; // Audit logs are immutable
      allow delete: if isValidId(movementId);
    }

    // POS Receipts & Sales Slips Collection
    match /receipts/{receiptId} {
      allow read: if true;
      allow create: if isValidId(receiptId) && isValidReceiptData(request.resource.data);
      allow update: if isValidId(receiptId) && isValidReceiptData(request.resource.data);
      allow delete: if isValidId(receiptId);
    }

    // Purchase Orders Collection
    match /purchase_orders/{poId} {
      allow read: if true;
      allow create: if isValidId(poId) && isValidPurchaseOrderData(request.resource.data);
      allow update: if isValidId(poId) && isValidPurchaseOrderData(request.resource.data);
      allow delete: if isValidId(poId);
    }

    // Suppliers Directory Collection
    match /suppliers/{supplierId} {
      allow read: if true;
      allow create: if isValidId(supplierId) && isValidSupplierData(request.resource.data);
      allow update: if isValidId(supplierId) && isValidSupplierData(request.resource.data);
      allow delete: if isValidId(supplierId);
    }

    // Daily Expenses
    match /expenses/{expenseId} {
      allow read: if true;
      allow create: if isValidId(expenseId) && isValidExpenseData(request.resource.data);
      allow update: if isValidId(expenseId) && isValidExpenseData(request.resource.data);
      allow delete: if isValidId(expenseId);
    }

    // Daily Bank Deposits
    match /bank_deposits/{depositId} {
      allow read: if true;
      allow create: if isValidId(depositId) && isValidDepositData(request.resource.data);
      allow update: if isValidId(depositId) && isValidDepositData(request.resource.data);
      allow delete: if isValidId(depositId);
    }

    // Field Sales Rep Dispatches & Return Reconciliations
    match /sales_rep_dispatches/{dispatchId} {
      allow read: if true;
      allow create: if isValidId(dispatchId) && isValidDispatchData(request.resource.data);
      allow update: if isValidId(dispatchId) && isValidDispatchData(request.resource.data);
      allow delete: if isValidId(dispatchId);
    }

    // Credit Customer Repayments
    match /credit_payments/{paymentId} {
      allow read: if true;
      allow create: if isValidId(paymentId) && isValidCreditPaymentData(request.resource.data);
      allow update: if isValidId(paymentId) && isValidCreditPaymentData(request.resource.data);
      allow delete: if isValidId(paymentId);
    }

    // Crate & Empty Bottle Returns Collection
    match /crate_returns/{returnId} {
      allow read: if true;
      allow create: if isValidId(returnId) && isValidCrateReturnData(request.resource.data);
      allow update: if isValidId(returnId) && isValidCrateReturnData(request.resource.data);
      allow delete: if isValidId(returnId);
    }

    // Staff Users & Accounts (Admin, Supervisors, Sales)
    function isValidUserData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 &&
             data.role is string &&
             data.status is string;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUserData(request.resource.data);
      allow update: if isValidId(userId) && isValidUserData(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // Active Supervisor Presences across different locations
    match /supervisor_presences/{presenceId} {
      allow read: if true;
      allow write: if isValidId(presenceId);
    }

    // Real-Time Activity Events Stream
    match /activity_events/{eventId} {
      allow read: if true;
      allow create: if isValidId(eventId);
      allow update: if false;
      allow delete: if isValidId(eventId);
    }

    // Cloud Dev Security & Synchronized Store Settings Configuration
    function isValidDevSecurityConfig(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.passwordHash is string && data.passwordHash.size() == 64 &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 100;
    }

    function isValidStoreSettingsData(data) {
      return data.companyName is string && data.companyName.size() <= 200 &&
             data.warehouseName is string && data.warehouseName.size() <= 200 &&
             data.currency is string && data.currency.size() > 0 && data.currency.size() <= 20 &&
             data.currencySymbol is string && data.currencySymbol.size() > 0 && data.currencySymbol.size() <= 10 &&
             data.lowStockThresholdGlobal is number && data.lowStockThresholdGlobal >= 0 &&
             (!('customLogoUrl' in data) || (data.customLogoUrl is string && data.customLogoUrl.size() <= 900000));
    }

    match /app_config/{configId} {
      allow read: if true;
      allow create: if isValidId(configId) && (
        (configId == 'dev_security' && isValidDevSecurityConfig(request.resource.data)) ||
        (configId == 'store_settings' && isValidStoreSettingsData(request.resource.data))
      );
      allow update: if isValidId(configId) && (
        (configId == 'dev_security' && isValidDevSecurityConfig(request.resource.data)) ||
        (configId == 'store_settings' && isValidStoreSettingsData(request.resource.data))
      );
      allow delete: if false;
    }

    // Active Device Sessions & Heartbeat Tracking (Dev Panel Monitor)
    function isValidDeviceSession(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 150 &&
             data.platform is string && data.platform.size() > 0 && data.platform.size() <= 100 &&
             data.userId is string && data.userId.size() <= 100 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.userRole is string && data.userRole.size() <= 50 &&
             data.status in ['online', 'offline', 'revoked'] &&
             data.lastActive is string && data.lastActive.size() > 0 && data.lastActive.size() <= 100 &&
             (!('isMaster' in data) || data.isMaster is bool) &&
             (!('syncRole' in data) || data.syncRole in ['master', 'replica']);
    }

    match /active_devices/{deviceId} {
      allow read: if true;
      allow create: if isValidId(deviceId) && isValidDeviceSession(request.resource.data);
      allow update: if isValidId(deviceId) && isValidDeviceSession(request.resource.data);
      allow delete: if isValidId(deviceId);
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
